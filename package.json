{
  "name": "raider-view",
  "version": "4.0.0",
  "description": "Azeroth Core Engine - WoW Raid Management Application",
  "author": "RaiderView Team",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "concurrently \"pnpm dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-build": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^42.1.0",
    "electron-builder": "^24.9.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.azerothcore.raiderview",
    "productName": "RaiderView",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "sign": false
    }
  }
}
